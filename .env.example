# Copy to .dev.vars for local Worker development when secrets are needed.
# Do not commit real API keys, passwords, Cloudflare tokens, or Money S4 credentials.

APP_ENV=development
API_BASE_URL=http://localhost:8787
DEMO_CUSTOMER_SERVICE_USER_ID=usr-cs-001
DEMO_SALES_USER_ID=usr-sales-002

# Required only when ai.provider is OPENAI. Store the real value in .dev.vars or
# a Cloudflare Worker secret; never put it in D1 or commit it.
OPENAI_API_KEY=

# Reserved for the future ERP phase.
MONEY_S4_API_BASE_URL=
MONEY_S4_CLIENT_ID=
MONEY_S4_CLIENT_SECRET=
