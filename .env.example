# Copy to .dev.vars for local Worker development when secrets are needed.
# Do not commit real API keys, passwords, Cloudflare tokens, or Money S4 credentials.

APP_ENV=development
API_BASE_URL=http://localhost:8787

# Local development uses the explicit mock mode. Production must use oidc and
# must configure every OIDC value; the Worker fails closed when they are absent.
AUTH_MODE=mock
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_LOGIN_URL=
AUTH_LOGOUT_URL=

# Required only when ai.provider is OPENAI. Store the real value in .dev.vars or
# a Cloudflare Worker secret; never put it in D1 or commit it.
OPENAI_API_KEY=

# Reserved for future campaign delivery providers. Keep real values in .dev.vars
# or Cloudflare Worker secrets; campaign-provider credentials never belong in D1.
ECOMAIL_API_KEY=
OMNISEND_API_KEY=

# Reserved for the future ERP phase.
MONEY_S4_API_BASE_URL=
MONEY_S4_CLIENT_ID=
MONEY_S4_CLIENT_SECRET=
